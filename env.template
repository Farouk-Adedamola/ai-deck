# NKIRU Call Microservice - Environment Variables Template
# Copy this to .env and fill in your actual values

## ==============================================
## DATABASE - Use EXTERNAL URL for local development
## ==============================================
## Get this from: Render Dashboard → Your Database → Info tab → "External Database URL"
## Format: postgresql://username:password@hostname:5432/database?sslmode=require
DATABASE_URL="postgresql://your_user:your_password@dpg-xxxxx-a.virginia-postgres.render.com:5432/nkiru_call_db?sslmode=require"

## ==============================================
## PINECONE CONFIGURATION
## ==============================================
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX_NAME="nkiru-faqs"

## ==============================================
## OPENAI CONFIGURATION
## ==============================================
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="text-embedding-3-small"

## ==============================================
## RETELL AI CONFIGURATION
## ==============================================
RETELL_API_KEY="your_retell_api_key_here"
RETELL_ASSISTANT_ID="your_assistant_id_here"

## ==============================================
## NKIRU API CONFIGURATION
## ==============================================
NKIRU_API_KEY="your_nkiru_api_key_here"
NKIRU_API_BASE_URL="https://stage-api.withnkiru.com"

## ==============================================
## SERVER CONFIGURATION
## ==============================================
NODE_ENV="development"
PORT=7720
LOG_LEVEL="debug"

## ==============================================
## FAQ SYNC CONFIGURATION (Optional)
## ==============================================
FAQ_SYNC_ENABLED="false"
FAQ_SYNC_INTERVAL_HOURS=24

## ==============================================
## IMPORTANT NOTES
## ==============================================
## 1. For LOCAL development: Use EXTERNAL Database URL (includes full hostname with .render.com:5432)
## 2. For PRODUCTION (Render): Use INTERNAL Database URL (shorter hostname, no port)
## 3. Always add ?sslmode=require to Render database URLs
## 4. Special characters in passwords need URL encoding:
##    @ → %40
##    # → %23
##    $ → %24
##    & → %26
## 5. Never commit the actual .env file to git (already in .gitignore)
