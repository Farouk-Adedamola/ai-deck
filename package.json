{
  "name": "nkiru-call-micro",
  "version": "1.0.0",
  "description": "NKIRU Voice Automation Microservice - Retell AI Integration",
  "main": "dist/src/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,json,md}\"",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:verify": "bash scripts/verify-db-connection.sh",
    "setup:assistant": "ts-node scripts/setup-assistant.ts",
    "mock:sync": "ts-node scripts/mock-sync-faqs.ts",
    "test:pinecone": "ts-node scripts/test-pinecone.ts"
  },
  "keywords": [
    "voice-automation",
    "retell-ai",
    "nkiru",
    "microservice"
  ],
  "author": "Farouk Adedamola",
  "license": "ISC",
  "dependencies": {
    "@pinecone-database/pinecone": "^6.0.0",
    "@prisma/client": "^5.8.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "retell-sdk": "^4.66.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
